{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schemaVersion": "0.0.1",
  "modelTags": "CNMD",
  "$id": "https://raw.githubusercontent.com/Libelium/DataModels-CIM-Medio-Tejo/main/Monitoramento%20do%20Meio%20Ambiente%20e%20Prote%C3%A7%C3%A3o%20Civil/schema/Alert.schema.json",
  "title": "Schema Alert da PGU do Médio Tejo",
  "description": "Alerta de risco emitido pela plataforma de gestão de riscos. Derivado do schema Alert do CNMD (versão 0.1.0), que descreve os alertas e avisos da proteção civil: address não é obrigatório, alertSource é texto e severity tem os valores do modelo Alert dos Smart Data Models. Só são obrigatórios id, type, category, dateIssued e alertSource; os restantes atributos são publicados se a origem os fornecer.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/GSMA-Commons"
    },
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/Location-Commons"
    },
    {
      "properties": {
        "address": {
          "type": "object",
          "description": "Propriedade. Morada da zona afetada. Modelo: 'https://schema.org/address'. Não publicado pela PGU.",
          "properties": {
            "addressCountry": {
              "type": "string",
              "description": "Propriedade. O país. Modelo: 'https://schema.org/addressCountry'."
            },
            "addressLocality": {
              "type": "string",
              "minLength": 1,
              "description": "Propriedade. A localidade, que tem de coincidir com o município. Modelo: 'https://schema.org/addressLocality'."
            },
            "addressRegion": {
              "type": "string",
              "enum": [
                "Norte",
                "Centro",
                "Oeste e Vale do Tejo",
                "Grande Lisboa",
                "Península de Setúbal",
                "Alentejo",
                "Algarve",
                "Região Autónoma dos Açores",
                "Região Autónoma da Madeira"
              ],
              "description": "Propriedade. A região NUTS 2 em que se situa a localidade. Modelo: 'https://schema.org/addressRegion'."
            },
            "district": {
              "type": "string",
              "enum": [
                "Açores",
                "Aveiro",
                "Beja",
                "Braga",
                "Bragança",
                "Castelo Branco",
                "Coimbra",
                "Évora",
                "Faro",
                "Guarda",
                "Madeira",
                "Leiria",
                "Lisboa",
                "Portalegre",
                "Porto",
                "Santarém",
                "Setúbal",
                "Viana do Castelo",
                "Vila Real",
                "Viseu"
              ],
              "description": "Propriedade. O distrito em que se situa a localidade."
            },
            "postalCode": {
              "type": "string",
              "description": "Propriedade. Código postal. Modelo: 'https://schema.org/postalCode'."
            },
            "streetAddress": {
              "type": "string",
              "description": "Propriedade. Endereço da rua. Modelo: 'https://schema.org/streetAddress'."
            },
            "streetNr": {
              "type": "string",
              "description": "Propriedade. Número de polícia. Modelo: 'https://schema.org/Text'."
            }
          },
          "required": [
            "addressLocality",
            "addressRegion",
            "district"
          ]
        },
        "type": {
          "type": "string",
          "const": "Alert",
          "description": "Propriedade. Tipo de entidade NGSI. Tem de ser Alert."
        },
        "alertSource": {
          "type": "string",
          "description": "Propriedade. Origem do alerta. Na PGU, a plataforma de gestão de riscos, em texto; no CNMD, um URL."
        },
        "category": {
          "type": "string",
          "enum": [
            "traffic",
            "naturalDisaster",
            "weather",
            "environment",
            "health",
            "security",
            "agriculture"
          ],
          "description": "Propriedade. Categoria do alerta: o tipo de risco da origem, traduzido para a lista do modelo. Se a origem não o indicar, environment."
        },
        "dateIssued": {
          "type": "string",
          "format": "date-time",
          "description": "Propriedade. Data e hora de emissão do alerta, em ISO 8601 UTC. É o único campo imprescindível da origem."
        },
        "description": {
          "type": "string",
          "description": "Propriedade. Mensagem do alerta, tal como vem da origem."
        },
        "severity": {
          "type": "string",
          "description": "Propriedade. Gravidade do alerta: o nível da origem, traduzido para informational, low, medium, high ou critical.",
          "enum": [
            "informational",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "subCategory": {
          "type": "string",
          "enum": [
            "trafficJam",
            "carAccident",
            "carWrongDirection",
            "carStopped",
            "pothole",
            "roadClosed",
            "roadWorks",
            "hazardOnRoad",
            "injuredBiker",
            "pedestrianOnRoad",
            "bikerOnRoad",
            "tramApproaching",
            "flood",
            "tsunami",
            "coastalEvent",
            "earthquake",
            "rainfall",
            "highTemperature",
            "lowTemperature",
            "heatWave",
            "coldWave",
            "ice",
            "snow",
            "wind",
            "fog",
            "tornado",
            "tropicalCyclone",
            "hurricane",
            "snow/ice",
            "thunderstorms",
            "fireRisk",
            "avalancheRisk",
            "floodRisk",
            "airPollution",
            "waterPollution",
            "pollenConcentration",
            "asthmaAttack",
            "bumpedPatient",
            "fallenPatient",
            "heartAttack",
            "suspiciousAction",
            "robbery",
            "assault",
            "civilDisorder",
            "buildingFire",
            "forestFire",
            "noxiousWeed",
            "snail",
            "insect",
            "rodent",
            "bacteria",
            "microbe",
            "fungus",
            "mite",
            "virus",
            "nematodes",
            "irrigation",
            "fertilisation"
          ],
          "description": "Propriedade. Subcategoria do alerta: o subtipo de risco, se a origem o distinguir."
        },
        "validFrom": {
          "type": "string",
          "format": "date-time",
          "description": "Propriedade. Início do período de validade do alerta, em ISO 8601."
        },
        "validTo": {
          "type": "string",
          "format": "date-time",
          "description": "Propriedade. Fim do período de validade do alerta, em ISO 8601."
        }
      }
    }
  ],
  "required": [
    "id",
    "type",
    "category",
    "dateIssued",
    "alertSource"
  ]
}
