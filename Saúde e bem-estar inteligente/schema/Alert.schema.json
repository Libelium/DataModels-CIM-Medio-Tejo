{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schemaVersion": "0.0.1",
  "modelTags": "CNMD",
  "$id": "https://raw.githubusercontent.com/Libelium/DataModels-CIM-Medio-Tejo/main/Sa%C3%BAde%20e%20bem-estar%20inteligente/schema/Alert.schema.json",
  "title": "Schema Alert da PGU do Médio Tejo",
  "description": "Alerta gerado por um dispositivo. Derivado do schema Alert do CNMD (versão 0.1.0), que descreve os alertas e avisos da proteção civil, para as quedas detetadas pelos relógios: address não é obrigatório, alertSource é uma relação com o relógio e severity tem os valores do modelo Alert dos Smart Data Models. Só são obrigatórios id, type, category, dateIssued e alertSource.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/GSMA-Commons"
    },
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/Location-Commons"
    },
    {
      "properties": {
        "address": {
          "type": "object",
          "description": "Propriedade. Morada associada ao alerta. Modelo: 'https://schema.org/address'. Não publicado pela PGU.",
          "properties": {
            "addressCountry": {
              "type": "string",
              "description": "Propriedade. O país. Modelo: 'https://schema.org/addressCountry'."
            },
            "addressLocality": {
              "type": "string",
              "minLength": 1,
              "description": "Propriedade. A localidade, que tem de coincidir com o município. Modelo: 'https://schema.org/addressLocality'."
            },
            "addressRegion": {
              "type": "string",
              "enum": [
                "Norte",
                "Centro",
                "Oeste e Vale do Tejo",
                "Grande Lisboa",
                "Península de Setúbal",
                "Alentejo",
                "Algarve",
                "Região Autónoma dos Açores",
                "Região Autónoma da Madeira"
              ],
              "description": "Propriedade. A região NUTS 2 em que se situa a localidade. Modelo: 'https://schema.org/addressRegion'."
            },
            "district": {
              "type": "string",
              "enum": [
                "Açores",
                "Aveiro",
                "Beja",
                "Braga",
                "Bragança",
                "Castelo Branco",
                "Coimbra",
                "Évora",
                "Faro",
                "Guarda",
                "Madeira",
                "Leiria",
                "Lisboa",
                "Portalegre",
                "Porto",
                "Santarém",
                "Setúbal",
                "Viana do Castelo",
                "Vila Real",
                "Viseu"
              ],
              "description": "Propriedade. O distrito em que se situa a localidade."
            },
            "postalCode": {
              "type": "string",
              "description": "Propriedade. Código postal. Modelo: 'https://schema.org/postalCode'."
            },
            "streetAddress": {
              "type": "string",
              "description": "Propriedade. Endereço da rua. Modelo: 'https://schema.org/streetAddress'."
            },
            "streetNr": {
              "type": "string",
              "description": "Propriedade. Número de polícia. Modelo: 'https://schema.org/Text'."
            }
          },
          "required": [
            "addressLocality",
            "addressRegion",
            "district"
          ]
        },
        "type": {
          "type": "string",
          "const": "Alert",
          "description": "Propriedade. Tipo de entidade NGSI. Tem de ser Alert."
        },
        "alertSource": {
          "type": "string",
          "format": "uri",
          "description": "Relação. Origem do alerta. Na PGU, o relógio (entidade Device) que detetou a queda; no CNMD, um URL. O paciente obtém-se através do relógio (Device.refPatient)."
        },
        "category": {
          "type": "string",
          "enum": [
            "traffic",
            "naturalDisaster",
            "weather",
            "environment",
            "health",
            "security",
            "agriculture"
          ],
          "description": "Propriedade. Categoria do alerta. Na PGU, health."
        },
        "dateIssued": {
          "type": "string",
          "format": "date-time",
          "description": "Propriedade. Data e hora da queda, em ISO 8601 UTC (a origem envia segundos Unix)."
        },
        "description": {
          "type": "string",
          "description": "Propriedade. Descrição textual do alerta."
        },
        "severity": {
          "type": "string",
          "description": "Propriedade. Gravidade do alerta: informational, low, medium, high ou critical. Na PGU, high: uma queda é sempre prioritária.",
          "enum": [
            "informational",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "subCategory": {
          "type": "string",
          "enum": [
            "trafficJam",
            "carAccident",
            "carWrongDirection",
            "carStopped",
            "pothole",
            "roadClosed",
            "roadWorks",
            "hazardOnRoad",
            "injuredBiker",
            "pedestrianOnRoad",
            "bikerOnRoad",
            "tramApproaching",
            "flood",
            "tsunami",
            "coastalEvent",
            "earthquake",
            "rainfall",
            "highTemperature",
            "lowTemperature",
            "heatWave",
            "coldWave",
            "ice",
            "snow",
            "wind",
            "fog",
            "tornado",
            "tropicalCyclone",
            "hurricane",
            "snow/ice",
            "thunderstorms",
            "fireRisk",
            "avalancheRisk",
            "floodRisk",
            "airPollution",
            "waterPollution",
            "pollenConcentration",
            "asthmaAttack",
            "bumpedPatient",
            "fallenPatient",
            "heartAttack",
            "suspiciousAction",
            "robbery",
            "assault",
            "civilDisorder",
            "buildingFire",
            "forestFire",
            "noxiousWeed",
            "snail",
            "insect",
            "rodent",
            "bacteria",
            "microbe",
            "fungus",
            "mite",
            "virus",
            "nematodes",
            "irrigation",
            "fertilisation"
          ],
          "description": "Propriedade. Subcategoria do alerta. Na PGU, fallenPatient (queda)."
        },
        "validFrom": {
          "type": "string",
          "format": "date-time",
          "description": "Propriedade. Início do período de validade do alerta, em ISO 8601: início do episódio."
        },
        "validTo": {
          "type": "string",
          "format": "date-time",
          "description": "Propriedade. Fim do período de validade do alerta, em ISO 8601: fim do episódio. Omitido enquanto o alerta está ativo."
        }
      }
    }
  ],
  "required": [
    "id",
    "type",
    "category",
    "dateIssued",
    "alertSource"
  ]
}
